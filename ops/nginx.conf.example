# Replace the example domain and certificate paths before use. Not auto-installed.
server {
    listen 443 ssl;
    server_name roomflow.example.com;
    ssl_certificate /etc/ssl/roomflow/fullchain.pem;
    ssl_certificate_key /etc/ssl/roomflow/privkey.pem;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
