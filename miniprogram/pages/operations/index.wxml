<view class="page"><view class="notice">经营与设备演示。真实支付和设备尚未接入。</view><view class="tabs"><button data-tab="finance" bindtap="tab">账务设备</button><button wx:if="{{actor.role === 'OWNER'}}" data-tab="config" bindtap="tab">经营配置</button><button wx:if="{{actor.role === 'OWNER'}}" data-tab="staff" bindtap="tab">员工</button></view>
<view wx:if="{{editor}}" class="card"><view class="heading">编辑经营信息</view><block wx:for="{{fields}}" wx:key="key"><view class="muted">{{item.label}}</view><picker wx:if="{{item.type === 'select'}}" range="{{item.range}}" value="{{item.index}}" data-key="{{item.key}}" bindchange="pick"><view class="form-row">{{item.range[item.index]}} ▾</view></picker><input wx:else class="form-row" type="{{item.type === 'number' ? 'digit' : 'text'}}" password="{{item.password}}" value="{{item.value}}" data-key="{{item.key}}" bindinput="input"/></block><button bindtap="save" disabled="{{busy}}">保存</button><button class="secondary" bindtap="close">返回</button></view>
<block wx:elif="{{tab === 'config'}}"><button data-kind="store" bindtap="edit">新增门店</button><view class="card" wx:for="{{config.stores}}" wx:key="id"><view class="name">{{item.name}}</view><view>保洁 {{item.cleaning_minutes}} 分钟 / 提前入场 {{item.early_minutes}} 分钟</view><button data-kind="store" data-id="{{item.id}}" bindtap="edit">编辑门店</button></view><button data-kind="room" bindtap="edit">新增包间</button><view class="card" wx:for="{{config.rooms}}" wx:key="id"><view class="name">{{item.name}}</view><button data-kind="room" data-id="{{item.id}}" bindtap="edit">编辑包间</button></view><button data-kind="package" bindtap="edit">新增套餐</button><view class="card" wx:for="{{config.packages}}" wx:key="id"><view>{{item.name}} · {{item.minutes}} 分钟</view><button data-kind="package" data-id="{{item.id}}" bindtap="edit">编辑套餐</button></view></block>
<block wx:elif="{{tab === 'staff'}}"><button data-kind="staff" bindtap="edit">新增门店管理员</button><view class="card" wx:for="{{staff}}" wx:key="id"><view>{{item.username}} · {{item.enabled ? '启用' : '停用'}}</view><button wx:if="{{item.role === 'MANAGER'}}" data-kind="staff" data-id="{{item.id}}" bindtap="edit">编辑 / 重置密码 / 停用</button></view></block>
<block wx:else><view class="heading">设备告警</view><view class="notice" wx:for="{{finance.alerts}}" wx:key="id">包间 {{item.room_id}}：{{item.error}}</view><view class="heading">收款记录</view><view class="card" wx:for="{{finance.payments}}" wx:key="id">{{item.booking_id}}<view>¥{{item.price}} · {{item.state}}</view></view><view class="heading">退款记录</view><view class="card" wx:for="{{finance.refunds}}" wx:key="id">{{item.booking_id}}<view>¥{{item.price}} · {{item.state}}</view><button wx:if="{{item.state === 'FAILED'}}" data-id="{{item.id}}" bindtap="retry">重试退款</button></view><view class="heading">设备指令</view><view class="card" wx:for="{{finance.commands}}" wx:key="id">包间{{item.room_id}} · {{item.action}} · {{item.state}} · 尝试{{item.attempts}}次</view></block></view>
