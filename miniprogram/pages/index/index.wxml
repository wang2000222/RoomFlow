<view class="page">
 <view class="brand">青禾 · 棋牌空间</view><view class="subtitle">预约一间好房，留一段相聚时光。</view>
 <view class="notice">作品演示：支付、退款、门锁与通电均为模拟。</view>
 <view wx:if="{{!actor}}" class="card"><view class="name">选择演示身份</view><button wx:if="{{capabilities.demo}}" data-account="guest" bindtap="login" disabled="{{busy}}">用户端体验</button><button class="secondary" wx:if="{{capabilities.demo}}" data-account="manager" bindtap="login" disabled="{{busy}}">城南店管理员</button><button class="secondary" wx:if="{{capabilities.demo}}" data-account="owner" bindtap="login" disabled="{{busy}}">商家负责人</button><button bindtap="wechatLogin" disabled="{{!capabilities.realWechatLogin}}">微信登录{{capabilities.realWechatLogin ? '' : '（未配置）'}}</button><input placeholder="员工账号" data-key="username" bindinput="inputLogin"/><input placeholder="员工密码" password data-key="password" bindinput="inputLogin"/><button bindtap="staffLogin">员工账号登录</button></view>
 <block wx:else>
  <view class="muted">{{actor.role === 'USER' ? '用户端' : '管理员端'}} · {{actor.id}}</view><button class="secondary" bindtap="logout">切换身份</button>
  <button wx:if="{{actor.role !== 'USER'}}" bindtap="manage">经营 / 账务 / 设备管理</button><picker range="{{storeNames}}" value="{{storeIndex}}" bindchange="storeChange"><view class="form-row">门店：{{storeNames[storeIndex]}} ▾</view></picker>
  <view class="tabs"><button data-tab="rooms" bindtap="tabChange">包间</button><button data-tab="orders" bindtap="tabChange">订单</button><button data-tab="notices" bindtap="tabChange">提醒</button></view>
  <view wx:if="{{selected}}" class="card"><view class="name">预约 {{selected.name}}</view><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="form-row">日期：{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="form-row">开始：{{time}}</view></picker><picker wx:if="{{packageIndex === 0}}" range="{{durations}}" value="{{durationIndex}}" bindchange="durationChange"><view class="form-row">时长：{{durations[durationIndex]}}</view></picker><picker range="{{packageNames}}" value="{{packageIndex}}" bindchange="packageChange"><view class="form-row">计价：{{packageNames[packageIndex]}}</view></picker><view class="price">合计 ¥{{quote}}</view><button bindtap="reserve" disabled="{{busy}}">提交预约</button></view>
  <block wx:elif="{{tab === 'rooms'}}"><view class="card" wx:for="{{rooms}}" wx:key="id"><view class="badge">{{item.label}}</view><view class="name">{{item.name}}</view><view class="muted">{{item.store_name}} · {{item.capacity}}人包间</view><view class="price">¥{{item.price}} / 小时</view><button wx:if="{{actor.role === 'USER'}}" data-id="{{item.id}}" bindtap="select" disabled="{{item.state === 'MAINTENANCE'}}">预约包间</button><block wx:else><button wx:if="{{item.state === 'CLEANING' || item.state === 'MAINTENANCE'}}" data-id="{{item.id}}" data-state="READY" bindtap="roomAction" disabled="{{busy}}">{{item.state === 'CLEANING' ? '保洁完成' : '恢复预约'}}</button><button wx:if="{{item.state === 'READY'}}" class="secondary" data-id="{{item.id}}" data-state="MAINTENANCE" bindtap="roomAction" disabled="{{busy}}">暂停预约</button></block></view></block>
  <block wx:elif="{{tab === 'notices'}}"><view class="notice" wx:for="{{notices}}" wx:key="id">{{item.message}}</view></block><block wx:else><view wx:if="{{orders.length === 0}}" class="empty">暂无预约订单</view><view class="card" wx:for="{{orders}}" wx:key="id"><view class="badge">{{item.label}}</view><view class="name">{{item.room_name}}</view><view class="muted">{{item.store_name}}</view><view>{{item.startText}} — {{item.endText}}</view><view class="price">¥{{item.price}}</view><button wx:if="{{item.state === 'PENDING' && actor.role === 'USER'}}" data-id="{{item.id}}" data-action="pay" bindtap="action" disabled="{{busy}}">演示支付</button><button wx:if="{{item.state === 'PAID'}}" data-id="{{item.id}}" data-action="open" bindtap="action" disabled="{{busy}}">模拟开门</button><button wx:if="{{item.state === 'IN_USE'}}" data-id="{{item.id}}" data-action="finish" bindtap="action" disabled="{{busy}}">结束使用</button><button wx:if="{{(item.state === 'PAID' || item.state === 'IN_USE') && actor.role === 'USER'}}" data-id="{{item.id}}" data-action="extend" bindtap="action" disabled="{{busy}}">续时1小时并演示支付</button><button wx:if="{{item.state === 'PENDING' || item.state === 'PAID'}}" class="secondary" data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{busy}}">{{item.state === 'PAID' ? '取消并模拟退款' : '取消预约'}}</button></view></block>
 </block>
</view>
