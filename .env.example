# Load into the process environment; Spring Boot does not auto-load this file.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8091
ROOMFLOW_DEMO=true
ROOMFLOW_JOBS=true
# Optional MySQL: create an EMPTY dedicated roomflow database first.
# DB_URL=jdbc:mysql://127.0.0.1:3306/roomflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USERNAME=roomflow
# DB_PASSWORD=
# Non-demo owner bootstrap (requires at least 12 characters):
# OWNER_USERNAME=
# OWNER_PASSWORD=
# WeChat server-side login only; real payment/devices are NOT implemented:
# WECHAT_APPID=
# WECHAT_SECRET=
